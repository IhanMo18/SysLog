<!-- SearchBar.razor -->
<div class="d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search">
    <div class="input-group border-bottom-1 border-dark" style="border-bottom: 2px solid black">
        <input
            type="text"
            class="form-control shadow-none bg-light border-0 border-bottom-1 border-dark small"
            placeholder="Search for..."
            @bind="SearchText"
        />
        <a role="button" class="btn" type="button" @onclick="HandleSearch">
            <i class="@(IsActive ? "fas fa-times" : "fas fa-search") fa-sm text-black"></i>
        </a>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<string> OnSearch { get; set; }
    
    [Parameter]
    public EventCallback<bool> ClearSearch { get; set; }

    private bool IsActive = false;
    private string SearchText { get; set; }

    private async Task HandleSearch()
    {
        if (IsActive)
        {
            SearchText = string.Empty;
            IsActive = false;
            await ClearSearch.InvokeAsync(true);
            return;
        }
        else
        {
            IsActive = true;
        }
        await OnSearch.InvokeAsync(SearchText);
    }
}