@page "/table"
@using SysLog.Client.Services
@using SysLog.Shared
@using SysLog.Shared.ModelDto
@using SysLog.Client.Utility
@using SysLog.Client.Components
@using SysLog.Repository.BackgroundServices
@using BackupService = SysLog.Client.Services.BackupService
@inject LogService LogService;
@inject  AuthProvider _authProvider
@inject BackupService BackupService


@if (_isAuthenticated)
{
    <div class="container-fluid">
    <div class="d-flex flex-column gap-4 mb-5">
        @if (_showAlert)
        {
            <Alert Result=_result></Alert>
        }
        
        <_ModalBackupFileDays BackupDays="@backupFileDtos"
                            OnSelectedDate="@SelectDay" />
    </div>
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Tabla de logs registrados</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                    <tr>
                        <th>LogType</th>
                        <th>IP Out</th>
                        <th>IP Destiny</th>
                        <th>Interface</th>
                        <th>Protocol</th>
                        <th>Action</th>
                        <th>Signature</th>
                        <th>Date</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (_loading)
                    {
                        <tr>
                            <td colspan="8" class="text-center">Loading logs...</td>
                        </tr>
                    }
                    else if (_logs == null || _logs.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center">No hay logs registrados</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in _logs)
                        {
                            <tr>
                                <td>@log.LogType.TypeName</td>
                                <td>@log.IpOut</td>
                                <td>@log.IpDestiny</td>
                                <td>@log.Interface.Name</td>
                                <td>@log.Protocol.Name</td>
                                <td>@log.Action.AcctionName</td>
                                <td>@log.LogType.Signature?.Message</td>
                                <td>@log.DateTime.ToString("yyyy/MM/dd")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <!-- Pagination Controls -->
            <div class="pagination-controls">
                <ul class="pagination justify-content-center">
                    <li class="page-item">
                        <button class="page-link @(@CurrentPage == 1 ? "disabled" : "")" @onclick="PreviousPage">Previous</button>
                    </li>
                    <li class="page-item">
                        <button class="page-link @(@CurrentPage == _logs.Count ? "disabled" : "")" @onclick="NextPage">Next</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
}
else
{
    <ErrorPage/>
}


@code {
    private bool _isAuthenticated = false;
    private List<LogDto> _logs { get; set; } = [];
    private List<LogDto> _originalLogs { get; set; } = [];
    private List<BackupFileDto> backupFileDtos = [];
    private bool _loading { get; set; }
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10;

    private bool _showAlert = false;
    private TaskResult _result { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await _authProvider.GetCurrentUser();

        if (result.IsSuccessful(out var currentUser))
        {
            _isAuthenticated = currentUser.IsAuthenticated;
        }
        else
        {
            _isAuthenticated = false;
        }
        await LoadLogs();
        await LoadBackups();
    }
    
    
        private async Task LoadLogs()
    {
        _loading = true;
        StateHasChanged();
        
        var result = await LogService.GetPagedLogs(CurrentPage, PageSize);

        if (result.IsSuccessful(out var logDtos))
        {
            _logs = logDtos;
            _originalLogs = logDtos;
            _loading = false;
        }
        else
        {
            _logs = new List<LogDto>();
            _loading = false;
            _showAlert = true;
            _result = TaskResult.FromFailure(result.Message, result.Code, result.Details);
        }

        _loading = false;
        StateHasChanged();
    }



    private async Task LoadBackups()
    {
        var backupResult = await BackupService.GetAllBackups();
        backupFileDtos = backupResult.IsSuccessful(out var backups) ? backups : [];
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await LoadLogs();
        }
    }

    private async Task NextPage()
    {
        CurrentPage++;
        await LoadLogs();
    }

    private void FilterLogs(string searchLog)
    {
        if (string.IsNullOrEmpty(searchLog))
            return;
        var _logs = _originalLogs.Where(l =>
            (l.Action.AcctionName is not null && l.Action.AcctionName.Contains(searchLog,StringComparison.OrdinalIgnoreCase)) ||
            ((l.IpOut is not null) && l.IpOut.Contains(searchLog,StringComparison.OrdinalIgnoreCase)) ||
            (l.DateTime.ToString("MM/dd/yyyy").Contains(searchLog,StringComparison.OrdinalIgnoreCase)) ||
            (l.Protocol is not null && l.Protocol.Name.Contains(searchLog,StringComparison.OrdinalIgnoreCase)) ||
            (l.LogType is not null && l.LogType.TypeName.Contains(searchLog,StringComparison.OrdinalIgnoreCase)) ||
            (l.LogType.Signature is not null && l.LogType.Signature.Message.Contains(searchLog,StringComparison.OrdinalIgnoreCase)) ||
            (l.Interface is not null && l.Interface.Name.Contains(searchLog,StringComparison.OrdinalIgnoreCase))
        ).ToList();
        StateHasChanged();
    }

    private async Task ClearTable(bool clear)
    {
        if (clear)
        {
            _logs = _originalLogs;
            await LoadLogs();
        }
    }

    private async Task SelectDay(string BackupName)
    {
       await BackupService.GetSelectedBackup(BackupName);
    }
}