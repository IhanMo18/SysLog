@using SysLog.Client.Services
@using SysLog.Shared.ModelDto
@page "/forgot-pass"
@inject AuthService _authService
@inject NavigationManager _navigationManager
@using FluentValidation
@using Blazored.FluentValidation
@using SysLog.Client.Models
@using SysLog.Client.Utility
@using SysLog.Shared

<div class="container">
    <!-- Outer Row -->
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-6 col-md-6">
            <div class="card o-hidden border-0 shadow-lg my-5">
                <div class="card-body p-0">
                    <!-- Nested Row within Card Body -->
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="p-5">
                                <div class="text-center">
                                    <h1 class="h4 text-gray-900 mb-2">Forgot Your Password?</h1>
                                    <p class="mb-4">We get it, stuff happens. Just enter your email address below
                                        and your new password</p>
                                </div>
                                <EditForm OnValidSubmit="ChangePassword" Model="_userLoginModel">
                                    <FluentValidationValidator @ref="_fluentValidationValidator"/>
                                    <div class="form-group">
                                        <InputText @bind-Value="_userLoginModel.Email" type="email" class="form-control form-control-user"
                                                   id="email" aria-describedby="emailHelp"
                                                   placeholder="Enter your email address..."/>
                                        <ValidationMessage For="@(() => _userLoginModel.Email)"/>
                                    </div>
                                    <div class="form-group">
                                        <InputText @bind-Value="_userLoginModel.Password" type="password" class="form-control form-control-user"
                                                   id="password" aria-describedby="emailHelp"
                                                   placeholder="Enter your new password..."/>
                                        <ValidationMessage For="@(() => _userLoginModel.Password)"/>
                                    </div>
                                    <a role="button" type="submit" class="btn btn-primary btn-user btn-block">
                                        Reset Password
                                    </a>
                                </EditForm>
                                <hr>
                                <div class="text-center">
                                    <NavLink class="small" href="/register">Create an Account!</NavLink>
                                </div>
                                <div class="text-center">
                                    <NavLink class="small" href="/login">Already have an account? Login!</NavLink>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @if (_showAlert)
            {
                <Alert Result="_result"/>
            }
        </div>
    </div>
</div>

@code {

    private FluentValidationValidator _fluentValidationValidator;
    private TaskResult _result;
    private bool _showAlert = false;
    private UserLoginModel _userLoginModel { get; } = new();

    private async Task ChangePassword()
    {
        var result = await _authService.ForgotPassword(_userLoginModel.Email, _userLoginModel.Password);
        _result = result;
        if (result.Success)
            _navigationManager.NavigateTo("/login");
        
        _showAlert = true;
    }

}