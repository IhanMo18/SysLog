@page "/login"
@using SysLog.Client.Services
@using SysLog.Shared
@using SysLog.Client.Utility

<div class="container">
    <!-- Outer Row -->
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-6 col-md-6">
            <div class="card o-hidden border-0 shadow-lg my-5">
                <div class="card-body p-0">
                    <!-- Nested Row within Card Body -->
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="p-5">
                                <div class="text-center">
                                    <h1 class="h4 text-gray-900 mb-4">Welcome Back!</h1>
                                </div>
                                <EditForm Model="_userLoginForm" OnValidSubmit="HandleLogin" class="user">
                                    <div class="form-group">
                                        <InputText @bind-Value="_userLoginForm.Email" type="email" class="form-control form-control-user"
                                                   id="exampleInputEmail" aria-describedby="emailHelp"
                                                   placeholder="Enter Email Address...">
                                        </InputText>
                                    </div>
                                    <div class="form-group">
                                        <InputText @bind-Value="_userLoginForm.Password" type="password" class="form-control form-control-user"
                                                   id="exampleInputPassword" placeholder="Password">
                                        </InputText>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-user btn-block">
                                        Login
                                    </button>
                                </EditForm>
                                <hr>
                                <div class="text-center">
                                    <NavLink class="small" href="/forgot-password">Forgot Password?</NavLink>
                                </div>
                                <div class="text-center">
                                    <NavLink class="small" href="/register">Create an Account!</NavLink>
                                </div>
                            </div>
                            <Alert Result=_result></Alert>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code{

    sealed class UserLoginForm
    {
        public UserLoginForm()
        {
        }

        public string Email { get; set; }
        public string Password { get; set; }
    }
    
    private UserLoginForm _userLoginForm { get; } = new();
    private TaskResult _result { get; set; } = new();

    [Inject] private NavigationManager _navigationManager { get; set; }
    [Inject] private AuthService _authService { get; set; }
    
    
    private async Task HandleLogin()
    {
        var result = await _authService.SignIn(_userLoginForm.Email,_userLoginForm.Password);
        if (result.Success)
        {
            _navigationManager.NavigateTo("/");
        }

        return;
    }

}